# Copy this file to .env and fill in the values.
# For tests, also create .env.test with DATABASE_URL pointing to a separate Neon branch.

# Database (Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (emails)
AUTH_RESEND_KEY=
EMAIL_FROM=
